# Local database (dev profile only — see application-dev.properties)
DB_USERNAME=postgres
DB_PASSWORD=

# Generate with: openssl rand -base64 48
# Never type a memorable phrase — JwtProperties rejects secrets with too little character variety.
JWT_SECRET=

# Optional — access-token lifetime in ms. Defaults to 900000 (15 min) if unset.
JWT_EXPIRY_MS=

# Required. OpenRouteService API key (500 req/day free tier): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Required. Google Gemini API key for AI itinerary generation: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional locally — application-dev.properties defaults these to dev-*-placeholder values.
# Required in prod (Cloudinary dashboard -> Account Details) for photo upload to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
